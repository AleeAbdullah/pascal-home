export const params={"length":{"default":2,"min":0.1,"max":15,"step":0.01},"depth":{"default":0.6,"min":0.1,"max":15,"step":0.01},"detail":{"default":1,"min":0,"max":1,"step":1},"shadows":{"default":1,"min":0,"max":1,"step":1}};export const mount="floor";
import {RoundedBoxGeometry} from 'three/addons/geometries/RoundedBoxGeometry.js';
const palette={"stone":["#d5c6b0",0.68,0],"walnut":["#58402e",0.58,0],"ivory":["#eee8dc",0.82,0],"linen":["#dcd2bf",0.96,0],"taupe":["#ad9c88",0.94,0],"bronze":["#40362b",0.4,0.65],"sage":["#6c725c",0.94,0],"charcoal":["#242522",0.8,0],"rug":["#d3c7b3",1,0],"vein":["#b4a18a",0.7,0],"leaf":["#455a36",0.8,0],"paper":["#f3e8d6",0.9,0]};
export default function build({params:p,THREE:T}){
const g=new T.Group(), mats={};
const D=(p.detail??1)>=.5, S=(p.shadows??1)>=.5; // detail: slats, veins, stripes, tessellation · shadows: cast shadows
function mat(k){if(!mats[k]){const [color,roughness,metalness]=palette[k];mats[k]=new T.MeshStandardMaterial({color,roughness,metalness});mats[k].name='slot_'+k;}return mats[k]}
function part(name){const q=new T.Group();q.name='part:'+name;g.add(q);return q}
function mesh(q,geo,k,x,y,z){const m=new T.Mesh(geo,mat(k));m.position.set(x,y,z);m.castShadow=S;m.receiveShadow=true;q.add(m);return m}
function box(q,w,h,d,x,y,z,k,r=.015){return mesh(q,D||Math.min(w,h,d)>.02?new RoundedBoxGeometry(w,h,d,D?3:1,Math.min(r,w/3,h/3,d/3)):new T.BoxGeometry(w,h,d),k,x,y,z)}
function cyl(q,r,h,x,y,z,k,r2=r){return mesh(q,new T.CylinderGeometry(r,r2,h,D?40:16),k,x,y,z)}
function ball(q,w,h,d,x,y,z,k){const m=mesh(q,new T.SphereGeometry(1,D?24:12,D?16:8),k,x,y,z);m.scale.set(w/2,h/2,d/2);return m}
function line(q,points,r,k){if(!D&&r<.003)return null;const curve=new T.CatmullRomCurve3(points.map(v=>new T.Vector3(...v)));return mesh(q,new T.TubeGeometry(curve,D?24:10,r,D?6:4,false),k,0,0,0)}
function light(){return null} // Point lights removed: the emissive glow strips carry the lit reading; real lights forced shader rebuilds on every room change.
function glow(q,w,h,d,x,y,z){const m=box(q,w,h,d,x,y,z,'paper',.004);m.castShadow=false;m.material=new T.MeshStandardMaterial({color:'#fff0d4',emissive:'#ffce85',emissiveIntensity:2});m.material.name='slot_glow';return m}

const q=part('hanging_run'),r=part('rails'),c=part('garments');const L=p.length,d=p.depth;
box(q,L,.08,d,0,.04,0,'walnut',.015);box(q,L,2.2,.025,0,1.1,-d/2+.0125,'walnut',.01);for(const x of [-L/2+.0125,L/2-.0125])box(q,.025,2.2,d,x,1.1,0,'walnut',.01);box(q,L,.03,d,0,2.2,0,'walnut',.012);box(q,L-.05,.025,d-.04,0,.4,0,'taupe',.008);
const rod=mesh(r,new T.CylinderGeometry(.013,.013,L-.05,D?20:8),'bronze',0,1.78,0);rod.rotation.z=Math.PI/2;const rod2=mesh(r,new T.CylinderGeometry(.013,.013,L-.05,D?20:8),'bronze',0,1.0,.02);rod2.rotation.z=Math.PI/2;
if(D){const ks=['linen','ivory','taupe','sage','paper','linen'];const n=Math.floor((L-.12)/.075);for(let i=0;i<n;i++){const x=-L/2+.07+i*(L-.14)/(n-1);box(c,.045,.95+(i%3)*.04,d*.58,x,1.78-.5-(i%3)*.02,.0,ks[(i*7)%ks.length],.012);if(i%2===0)box(c,.04,.7,d*.5,x,1.0-.4,.02,ks[(i*3+1)%ks.length],.012)}}glow(r,L-.1,.01,.02,0,2.17,d/2-.05)
return g;}