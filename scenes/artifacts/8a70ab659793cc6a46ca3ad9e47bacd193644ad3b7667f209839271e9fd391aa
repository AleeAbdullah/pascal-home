export const params={"width":{"default":4.3,"min":0.1,"max":15,"step":0.01},"depth":{"default":3.8,"min":0.1,"max":15,"step":0.01}};export const mount="floor";
import {RoundedBoxGeometry} from 'three/addons/geometries/RoundedBoxGeometry.js';
const palette={"stone":["#d5c6b0",0.68,0],"walnut":["#58402e",0.58,0],"ivory":["#eee8dc",0.82,0],"linen":["#dcd2bf",0.96,0],"taupe":["#ad9c88",0.94,0],"bronze":["#40362b",0.4,0.65],"sage":["#6c725c",0.94,0],"charcoal":["#242522",0.8,0],"rug":["#d3c7b3",1,0],"vein":["#b4a18a",0.7,0],"leaf":["#455a36",0.8,0],"paper":["#f3e8d6",0.9,0]};
export default function build({params:p,THREE:T}){
const g=new T.Group(), mats={};
function mat(k){if(!mats[k]){const [color,roughness,metalness]=palette[k];mats[k]=new T.MeshStandardMaterial({color,roughness,metalness});mats[k].name='slot_'+k;}return mats[k]}
function part(name){const q=new T.Group();q.name='part:'+name;g.add(q);return q}
function mesh(q,geo,k,x,y,z){const m=new T.Mesh(geo,mat(k));m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;q.add(m);return m}
function box(q,w,h,d,x,y,z,k,r=.015){return mesh(q,new RoundedBoxGeometry(w,h,d,3,Math.min(r,w/3,h/3,d/3)),k,x,y,z)}
function cyl(q,r,h,x,y,z,k,r2=r){return mesh(q,new T.CylinderGeometry(r,r2,h,40),k,x,y,z)}
function ball(q,w,h,d,x,y,z,k){const m=mesh(q,new T.SphereGeometry(1,24,16),k,x,y,z);m.scale.set(w/2,h/2,d/2);return m}
function line(q,points,r,k){const curve=new T.CatmullRomCurve3(points.map(v=>new T.Vector3(...v)));return mesh(q,new T.TubeGeometry(curve,24,r,6,false),k,0,0,0)}
function light(q,id,x,y,z,power=16){const l=new T.PointLight('#ffdab0',power,5,2);l.name='light:'+id;l.position.set(x,y,z);q.add(l);return l}
function glow(q,w,h,d,x,y,z){const m=box(q,w,h,d,x,y,z,'paper',.004);m.material=new T.MeshStandardMaterial({color:'#fff0d4',emissive:'#ffce85',emissiveIntensity:2});m.material.name='slot_glow';return m}

const q=part('woven_rug');box(q,p.width,.014,p.depth,0,.007,0,'rug',.006);box(q,p.width-.10,.002,p.depth-.10,0,.015,0,'linen',.001);for(const x of [-p.width/2+.08,p.width/2-.08])box(q,.012,.003,p.depth-.14,x,.017,0,'taupe',.001);for(let i=0;i<42;i++)box(q,p.width-.16,.001,.004,0,.017,-p.depth/2+.09+i*(p.depth-.18)/41,'rug',.0003)
return g;}